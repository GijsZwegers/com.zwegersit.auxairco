{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.zwegersit.auxairco",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "AUX Airco"
  },
  "description": {
    "en": "Control your AUX Freedom split-unit air conditioner: power, mode, target and measured room temperature, and fan speed, all through the AUX Cloud."
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "brandColor": "#1A5CA8",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Gijs Zwegers",
    "email": "gijszwegers@gmail.com"
  },
  "drivers": [
    {
      "name": {
        "en": "AUX Airco",
        "nl": "AUX Airco"
      },
      "class": "airconditioning",
      "capabilities": [
        "onoff",
        "thermostat_mode",
        "target_temperature",
        "measure_temperature",
        "aux_fan_speed"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 32,
          "step": 0.5
        },
        "thermostat_mode": {
          "values": [
            {
              "id": "auto",
              "title": {
                "en": "Auto",
                "nl": "Auto"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool",
                "nl": "Koelen"
              }
            },
            {
              "id": "dry",
              "title": {
                "en": "Dry",
                "nl": "Drogen"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat",
                "nl": "Verwarmen"
              }
            },
            {
              "id": "fan",
              "title": {
                "en": "Fan",
                "nl": "Ventilator"
              }
            }
          ]
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "images": {
        "small": "/drivers/airco/assets/images/small.png",
        "large": "/drivers/airco/assets/images/large.png"
      },
      "pair": [
        {
          "id": "login_credentials",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email address",
              "nl": "E-mailadres"
            },
            "usernamePlaceholder": {
              "en": "you@example.com"
            },
            "passwordLabel": {
              "en": "Password",
              "nl": "Wachtwoord"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "airco"
    }
  ],
  "capabilities": {
    "aux_fan_speed": {
      "type": "enum",
      "title": {
        "en": "Fan speed",
        "nl": "Ventilatorsnelheid"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "auto",
          "title": {
            "en": "Auto",
            "nl": "Auto"
          }
        },
        {
          "id": "low",
          "title": {
            "en": "Low",
            "nl": "Laag"
          }
        },
        {
          "id": "medium_low",
          "title": {
            "en": "Medium-low",
            "nl": "Medium-laag"
          }
        },
        {
          "id": "medium",
          "title": {
            "en": "Medium",
            "nl": "Medium"
          }
        },
        {
          "id": "medium_high",
          "title": {
            "en": "Medium-high",
            "nl": "Medium-hoog"
          }
        },
        {
          "id": "high",
          "title": {
            "en": "High",
            "nl": "Hoog"
          }
        },
        {
          "id": "turbo",
          "title": {
            "en": "Turbo",
            "nl": "Turbo"
          }
        },
        {
          "id": "mute",
          "title": {
            "en": "Mute",
            "nl": "Stil"
          }
        }
      ]
    }
  }
}