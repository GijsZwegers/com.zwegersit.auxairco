{
  "name": {
    "en": "AUX Airco",
    "nl": "AUX Airco"
  },
  "class": "airconditioning",
  "capabilities": [
    "onoff",
    "thermostat_mode",
    "target_temperature",
    "measure_temperature",
    "aux_fan_speed"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 16,
      "max": 32,
      "step": 0.5
    },
    "thermostat_mode": {
      "values": [
        { "id": "auto", "title": { "en": "Auto", "nl": "Auto" } },
        { "id": "cool", "title": { "en": "Cool", "nl": "Koelen" } },
        { "id": "dry", "title": { "en": "Dry", "nl": "Drogen" } },
        { "id": "heat", "title": { "en": "Heat", "nl": "Verwarmen" } },
        { "id": "fan", "title": { "en": "Fan", "nl": "Ventilator" } }
      ]
    }
  },
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "images": {
    "small": "/drivers/airco/assets/images/small.png",
    "large": "/drivers/airco/assets/images/large.png"
  },
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "usernameLabel": { "en": "Email address", "nl": "E-mailadres" },
        "usernamePlaceholder": { "en": "you@example.com" },
        "passwordLabel": { "en": "Password", "nl": "Wachtwoord" }
      }
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": { "next": "add_devices" }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
